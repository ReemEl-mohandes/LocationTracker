# Copy to .env and replace every value. .env is gitignored; this file is not.

POSTGRES_DB=locationtracker
POSTGRES_USER=locationtracker
POSTGRES_PASSWORD=replace-with-a-strong-password

# Must be at least 32 bytes or the API refuses to start.
# Generate one with:  openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-at-least-32-bytes-of-random-key-material
JWT_ISSUER=LocationTracker
JWT_AUDIENCE=LocationTracker

# The bootstrap administrator. Registration only ever grants the User role, so without
# this there is no way to obtain an admin account. Created once, never reset on restart.
# Must satisfy the password policy: 12+ chars, upper, lower, digit, symbol.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Replace!This0Password

CORS_ORIGIN=https://localhost
ASPNETCORE_ENVIRONMENT=Production

# Normalize to LF in the repository.
* text=auto eol=lf

# These must keep LF even when checked out on Windows: a CRLF shebang makes the
# kernel look for an interpreter called "bash\r", and the script dies with a
# confusing "bad interpreter" error inside WSL, a container, or Git Bash.
*.sh          text eol=lf
Dockerfile    text eol=lf
*.conf        text eol=lf
*.yml         text eol=lf

# Binary, never munged.
*.png binary
*.jpg binary
*.pfx binary
